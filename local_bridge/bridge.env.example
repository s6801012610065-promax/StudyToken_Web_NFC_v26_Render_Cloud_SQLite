# Copy this file to bridge.env and fill in the values.
# Your Render public URL (https is required):
SERVER_URL=https://YOUR-SERVICE.onrender.com
# Same value as the BRIDGE_TOKEN environment variable in Render (Dashboard > Environment):
BRIDGE_TOKEN=paste-the-long-token-here
# COM port of the PN532, or "auto" to scan COM1..COM30 like the original app:
COM_PORT=auto
# Reader driver: raw = built-in PN532 UART driver (default, recommended for PN532 + NTAG213/215/216),
# nfcpy = legacy, auto = raw first then nfcpy
# READER_BACKEND=raw
# Serial speed of the PN532 board (default 115200)
# BAUD=115200
# Optional: name shown on the server
# BRIDGE_ID=my-desktop
# Optional: only if BASE_URL on Render is a custom domain different from SERVER_URL (comma separated hosts)
# ALLOWED_WRITE_HOSTS=study.example.com
